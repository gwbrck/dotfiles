if status is-interactive
    abbr g git
    abbr ga 'git add'
    abbr gaa 'git add --all'
    abbr gc 'git commit'
    abbr gcl 'git clone --recurse-submodules'
    abbr gd 'git diff'
    abbr gss 'git status -s'
    abbr gst 'git status'
    abbr l 'ls -la'
    abbr .. 'cd ..'
    abbr ... 'cd ../..'
    abbr .... 'cd ../../..'
    abbr ..... 'cd ../../../..'
    abbr ...... 'cd ../../../../..'
end
